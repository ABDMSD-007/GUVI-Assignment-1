# Copy this file's values into your environment (or use the "local" Spring profile).
# These environment variables are read by src/main/resources/application.properties.

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/nacl
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT (secret must be at least 32 characters)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=3600000

